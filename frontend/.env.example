# ===========================================================================
# FRONTEND — Biến môi trường Vite (chỉ các biến có tiền tố VITE_ mới được
#            đưa vào bundle build — Vite sẽ thay thế tĩnh tại thời điểm build)
# ===========================================================================
# HƯỚNG DẪN: Copy file này thành .env (local dev) hoặc thêm từng biến
# vào Vercel Dashboard > Project > Settings > Environment Variables.

# ---------------------------------------------------------------------------
# [BẮT BUỘC] Supabase Auth & API Gateway
# Lấy từ: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
VITE_GOTRUE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ---------------------------------------------------------------------------
# [TÙY CHỌN] PostgREST URL riêng (khi self-host PostgREST / không dùng Supabase Data API)
# Nếu bỏ trống, hệ thống tự build: ${VITE_GOTRUE_URL}/rest/v1
# ---------------------------------------------------------------------------
# VITE_POSTGREST_URL=https://your-postgrest-server.onrender.com

# ---------------------------------------------------------------------------
# [TÙY CHỌN] Backend Express API (nếu có các endpoint tự viết ngoài PostgREST)
# ---------------------------------------------------------------------------
# VITE_API_URL=https://trip-manager-backend.onrender.com

# ---------------------------------------------------------------------------
# [TÙY CHỌN] WebSocket Jobs Service URL (dùng giao thức wss:// cho HTTPS)
# ---------------------------------------------------------------------------
# VITE_WS_URL=wss://trip-manager-jobs.onrender.com

# ---------------------------------------------------------------------------
# [BẮT BUỘC] Gemini AI API Key (dùng cho tính năng OCR quét hóa đơn)
# Lấy từ: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your-gemini-api-key
