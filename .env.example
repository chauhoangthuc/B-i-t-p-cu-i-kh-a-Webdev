# ==========================================
# 1. CẤU HÌNH BACKEND (Node.js Express + Prisma)
# ==========================================
PORT=5000

# URL kết nối CSDL PostgreSQL (Sử dụng Connection String của Supabase)
# - DATABASE_URL: Dùng chuỗi connection pooling (Transaction mode - cổng 6543) của Supabase để chạy ứng dụng
# - DIRECT_URL: Dùng chuỗi kết nối trực tiếp (Session mode - cổng 5432) để chạy Prisma Migrations
DATABASE_URL="postgres://postgres.your-supabase-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.your-supabase-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Cấu hình JWT cho Authentication (nếu Backend có sử dụng xác thực riêng)
JWT_SECRET="your-super-secret-jwt-key"

# Cấu hình gửi Email (Nodemailer - Gmail / SendGrid / SMTP khác)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password" # Chuỗi 16 ký tự Google App Password

# Cấu hình dự báo thời tiết (Open-Meteo)
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_API_KEY="" # Để trống vì Open-Meteo API free không cần key

# Cấu hình WebSocket (Jobs Service)
WS_PORT=8080

# Cấu hình Supabase GoTrue Auth (nếu tích hợp Google OAuth)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOTRUE_EXTERNAL_GOOGLE_SECRET="your-google-client-secret"


# ==========================================
# 2. CẤU HÌNH FRONTEND (React SPA - Vite)
# ==========================================
# API endpoint kết nối tới Express Backend
VITE_API_URL="https://your-backend-on-render.onrender.com"

# API endpoint kết nối tới WebSocket Server (Jobs Service)
VITE_WS_URL="wss://your-jobs-service-on-render.onrender.com"

# Khóa API cho AI Gemini OCR bóc tách hóa đơn
VITE_GEMINI_API_KEY="your-gemini-api-key"

# Cấu hình Supabase Auth client-side
VITE_GOTRUE_URL="https://your-supabase-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"


# ==========================================
# 3. CẤU HÌNH JOBS SERVICE
# ==========================================
# Có thể tái sử dụng DATABASE_URL, SMTP_*, WEATHER_* ở phần 1
LOG_LEVEL="info"
